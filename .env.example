# LLM provider configuration (OpenAI-compatible API).
# Defaults target Google Gemini's OpenAI-compatible endpoint; override any of
# these to use a different provider.

# API key (required). LLM_API_KEY takes precedence; GEMINI_API_KEY also works.
LLM_API_KEY=

# Model id (optional; default: gemini-flash-lite-latest).
# Lite has a much higher free-tier daily request quota. For a stronger model
# (if your quota allows), use gemini-flash-latest.
LLM_MODEL=gemini-flash-lite-latest

# OpenAI-compatible base URL (optional; default: Gemini's endpoint)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
